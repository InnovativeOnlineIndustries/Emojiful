{
    "schemaVersion": 1,
    "id": "emojiful",
    "version": "${version}",
    "name": "Emojiful",
    "description": "Adds Emojis to the Game Chat!!!",
    "authors": [
      "HorizonStudio"
    ],
    "contact": {
      "homepage": "https://github.com/InnovativeOnlineIndustries/Emojiful/issues",
      "sources": "https://github.com/InnovativeOnlineIndustries/Emojiful"
    },
    "license": "MIT",
    "icon": "assets/emojiful/icon.png",

    "environment": "client",
    "entrypoints": {
      "main": [
        "com.hrznstudio.emojiful.EmojifulFabric"
      ]
    },
    "mixins": [
      "emojiful.mixins.json",
      "emojiful.fabric.mixins.json"
    ],
    "depends": {
      "fabricloader": ">=0.19.3",
      "minecraft": "26.1.2",
      "fabric-api" : "*",
      "java": ">=25"
    },
    "accessWidener": "emojifulcommon.accesswidener"
  }
